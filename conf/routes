# Routes: higher priority routes first

GET     /                           controllers.Default.redirect(to = "/presenter")

# Presenter: live results
GET     /presenter                  name.lorenzani.andrea.bbc.controllers.PresenterController.index
GET     /presenter/event            name.lorenzani.andrea.bbc.controllers.PresenterController.event
GET     /presenter/result           name.lorenzani.andrea.bbc.controllers.PresenterController.result
GET     /presenter/websocket        name.lorenzani.andrea.bbc.controllers.PresenterController.websocket

# Admin: opens events
GET     /admin                      name.lorenzani.andrea.bbc.controllers.AdminController.index
GET     /admin/event                name.lorenzani.andrea.bbc.controllers.AdminController.event
POST    /admin/event                name.lorenzani.andrea.bbc.controllers.AdminController.createEvent

# Voter: casts votes
GET     /voter                      name.lorenzani.andrea.bbc.controllers.VoterController.index
GET     /voter/event                name.lorenzani.andrea.bbc.controllers.VoterController.event
POST    /voter/vote                 name.lorenzani.andrea.bbc.controllers.VoterController.addVote

# Static resources
GET     /assets/*file               controllers.Assets.versioned(path="/public", file: Asset)
